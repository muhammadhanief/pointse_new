# Contoh /etc/pointse/pointse.env untuk server AlmaLinux/aaPanel.
# Salin, lalu isi nilai rahasia dari pengelola rahasia. Jangan commit file .env.
# File ini dibaca oleh pointse-api.service dan pointse-worker.service.

APP_NAME=pointse
DEBUG=false
ENV=production
API_PREFIX=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pointse

# Origin frontend Next.js (HTTPS, tanpa trailing slash).
CORS_ORIGINS=["https://pointse.web.bps.go.id"]

# Token Bearer HS256. Isi AUTH_SECRET minimal 32 karakter; nilainya harus sama
# dengan kunci penanda tangan di frontend.
AUTH_MODE=jwt
AUTH_SECRET=
AUTH_ISSUER=pointse
AUTH_AUDIENCE=pointse-backend

DIR_UNGGAHAN=/home/pointse-data/unggahan
DIR_MASTER=/home/pointse-data/master

# 0 = tanpa batas total; potongan tetap 16 MiB.
UNGGAH_MAKS_BYTES=0
UNGGAH_POTONGAN_BYTES=16777216
UNGGAH_KEDALUWARSA_JAM=24

# API tidak menjalankan worker di dalam uvicorn.
WORKER_ENABLED=false
# Hanya untuk worker in-process (WORKER_ENABLED=true); service --loop memakai
# satu proses per unit. Worker tambahan: unit template pointse-worker@.service.
MAX_WORKERS=1
WORKER_POLL_DETIK=5
WORKER_HEARTBEAT_DETIK=15
WORKER_MEM_BUDGET_MB=800
WORKER_LOCK_FILE=/home/pointse-data/worker.lock
WORKER_HEARTBEAT_TIMEOUT_DETIK=60
WORKER_EVENT_RETENSI_HARI=7
WORKER_EVENT_MAKS=5000

# Berkas status backup yang ditulis deploy/backup.sh (dibaca halaman Status
# Sistem). Letakkan di folder yang dapat dibaca pengguna service pointse.
BACKUP_STATUS_FILE=/home/pointse-data/backup-status.json

# Produksi: proses per 50.000 titik agar puncak RAM worker terkendali.
PROSES_CHUNK_TITIK=50000
# Job yang heartbeat-nya lebih lama dari ini dianggap terhenti. Naikkan (mis.
# 120) bila kabupaten besar bisa >30 menit di fase akhir, apalagi bila ada
# lebih dari satu worker: worker lain akan menandai job itu gagal padahal
# masih berjalan.
JOB_TIMEOUT_MENIT=30
