# Contoh /etc/pointse/pointse.env untuk server AlmaLinux/aaPanel.
# Salin, lalu isi nilai rahasia dari pengelola rahasia. Jangan commit file .env.
# File ini dibaca oleh pointse-api.service dan pointse-worker.service.

APP_NAME=pointse
DEBUG=false
ENV=production
API_PREFIX=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pointse

# Origin frontend statis (HTTPS, tanpa trailing slash).
CORS_ORIGINS=["https://pointse.web.bps.go.id"]

# Token Bearer HS256. Isi AUTH_SECRET minimal 32 karakter; nilainya harus sama
# dengan kunci penanda tangan di frontend.
AUTH_MODE=jwt
AUTH_SECRET=
AUTH_ISSUER=pointse
AUTH_AUDIENCE=pointse-backend

DIR_UNGGAHAN=/home/pointse-data/unggahan
DIR_MASTER=/home/pointse-data/master

UNGGAH_MAKS_BYTES=314572800
UNGGAH_POTONGAN_BYTES=16777216
UNGGAH_KEDALUWARSA_JAM=24

# API tidak menjalankan worker di dalam uvicorn.
WORKER_ENABLED=false
MAX_WORKERS=1
WORKER_POLL_DETIK=5
WORKER_HEARTBEAT_DETIK=15
WORKER_MEM_BUDGET_MB=800
WORKER_LOCK_FILE=/home/pointse-data/worker.lock

# Produksi: proses per 50.000 titik agar puncak RAM worker terkendali.
PROSES_CHUNK_TITIK=50000
JOB_TIMEOUT_MENIT=30
