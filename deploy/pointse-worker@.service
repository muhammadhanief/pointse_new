[Unit]
Description=pointse worker Proses A/B (instance %i)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=pointse
Group=pointse
WorkingDirectory=/opt/pointse/backend
EnvironmentFile=/etc/pointse/pointse.env
RuntimeDirectory=pointse-%i
RuntimeDirectoryPreserve=no
# Nilai per instance ditulis sebagai prefiks ExecStart, BUKAN Environment=:
# EnvironmentFile= selalu menimpa Environment=, sehingga WORKER_LOCK_FILE dari
# /etc/pointse/pointse.env akan dipakai bersama dan instance kedua langsung
# keluar ("worker --loop lain sedang berjalan").
# - WORKER_MEM_BUDGET_MB=700: total worker = jumlah instance x nilai ini, jadi
#   jangan pakai 800 seperti service utama kalau RAM tersisa mepet.
# - WORKER_LOCK_FILE: kunci flock terpisah per instance (%i).
ExecStart=/usr/bin/env WORKER_MEM_BUDGET_MB=700 WORKER_LOCK_FILE=/run/pointse-%i/worker.lock /opt/pointse/backend/.venv/bin/python -m app.worker --loop
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=600
MemoryMax=1100M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
