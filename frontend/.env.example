# SSO BPS (Keycloak) - nilai dari portal accounts.bps.go.id.
# Redirect URI harus sama persis dengan yang didaftarkan (protokol, host, port, path).
KEYCLOAK_URL=https://accounts.bps.go.id
KEYCLOAK_REALM=pegawai
KEYCLOAK_CLIENT_ID=isi-client-id
KEYCLOAK_CLIENT_SECRET=isi-client-secret
KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback
KEYCLOAK_SCOPE="openid profile email"

# Sesi aplikasi. AUTH_SECRET harus sama dengan backend/.env (minimal 32 karakter).
AUTH_SECRET=
AUTH_ISSUER=pointse
AUTH_AUDIENCE=pointse-backend

# URL publik frontend, dipakai untuk redirect di balik proxy/cPanel.
APP_URL=http://localhost:3000

# URL API backend. Nilai ini dibaca saat build. Browser memanggil backend
# langsung (lintas origin) dengan Authorization: Bearer; server cPanel tidak
# pernah menjangkau domain backend.
# Production: https://backend-pointse.feinah.web.id
# Lokal: http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Jumlah potongan unggahan yang dikirim bersamaan (1-4). Default 2.
NEXT_PUBLIC_UNGGAH_PARALEL=2

# Bypass login untuk pengujian. Default mati.
# Di production, AUTH_BYPASS_SECRET wajib diisi dan jangan dibagikan.
AUTH_BYPASS_ENABLED=false
AUTH_BYPASS_SECRET=
