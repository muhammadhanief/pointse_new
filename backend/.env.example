# Salin file ini jadi `.env`, lalu isi nilainya.
# File `.env` JANGAN di-commit (sudah masuk .gitignore).
# Jangan menulis kunci/kata sandi nyata di file contoh ini.
#
# Ini contoh untuk pengembangan lokal. Untuk server AlmaLinux gunakan
# deploy/.env.example (ENV=production, AUTH_MODE=jwt).

APP_NAME=pointse
DEBUG=true
ENV=development
# Prefix API; kosong = API di akar domain. Contoh: /api
API_PREFIX=

# MySQL/MariaDB (hanya backend yang mengaksesnya)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pointse

# Origin frontend yang diizinkan memanggil API (format JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Autentikasi: token HS256 dari frontend dikirim sebagai Authorization: Bearer.
# AUTH_MODE=dev hanya untuk tes/mode lokal. Di production wajib jwt + AUTH_SECRET
# minimal 32 karakter.
AUTH_MODE=dev
AUTH_SECRET=
AUTH_ISSUER=pointse
AUTH_AUDIENCE=pointse-backend

# Folder penyimpanan berkas unggahan (GPKG/GeoJSON), di disk server bukan di DB
DIR_UNGGAHAN=data/unggahan

# Folder geotag master per kabupaten (permanen, jangan di dalam DIR_UNGGAHAN)
DIR_MASTER=data/master

# Unggahan berpotongan (application/octet-stream). Total ukuran per berkas
# (0 = tanpa batas), ukuran tiap potongan (maksimal 100 MiB), dan umur sesi sementara.
UNGGAH_MAKS_BYTES=0
UNGGAH_POTONGAN_BYTES=16777216
UNGGAH_KEDALUWARSA_JAM=24

# Worker pemroses job Proses A/B.
# Worker dijalankan sebagai proses terpisah (--loop), jadi API memakai false.
WORKER_ENABLED=false
MAX_WORKERS=1
WORKER_POLL_DETIK=5
WORKER_HEARTBEAT_DETIK=15
WORKER_MEM_BUDGET_MB=800
# Kosong = <induk DIR_UNGGAHAN>/worker.lock
WORKER_LOCK_FILE=

# 0 = titik dibaca/diproses sekaligus; > 0 = per potongan (hemat memori)
PROSES_CHUNK_TITIK=0

# Job "jalan" yang heartbeat-nya lebih lama dari ini (menit) dianggap terhenti
JOB_TIMEOUT_MENIT=10
