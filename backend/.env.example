# Salin file ini jadi `.env`, lalu isi nilainya.
# File `.env` JANGAN di-commit (sudah masuk .gitignore).

APP_NAME=pointse
DEBUG=true

# MySQL (port tidak dibuka ke internet)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pointse

# Domain frontend yang diizinkan memanggil API (format JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Autentikasi (T4): token sesi HS256 dari frontend diverifikasi backend.
# AUTH_SECRET harus sama persis dengan frontend; minimal 32 karakter.
# AUTH_REQUIRED=false HANYA untuk tes/mode lokal tanpa SSO.
AUTH_REQUIRED=true
AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
AUTH_ISSUER=pointse
AUTH_AUDIENCE=pointse-backend

# Folder penyimpanan berkas unggahan (GPKG/GeoJSON), di disk server bukan di DB
DIR_UNGGAHAN=data/unggahan

# Folder geotag master per kabupaten (permanen, jangan di dalam DIR_UNGGAHAN)
DIR_MASTER=data/master

# Worker pemroses job Proses A/B
# WORKER_ENABLED=false kalau worker dijalankan sebagai proses terpisah
WORKER_ENABLED=true
MAX_WORKERS=1
INTERVAL_POLLING=1.0

# 0 = titik dibaca/diproses sekaligus; > 0 = per potongan (hemat memori)
PROSES_CHUNK_TITIK=0

# Job "jalan" yang heartbeat-nya lebih lama dari ini (menit) dianggap terhenti
JOB_TIMEOUT_MENIT=10
