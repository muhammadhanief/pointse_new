# Salin file ini jadi `.env`, lalu isi nilainya.
# File `.env` JANGAN di-commit (sudah masuk .gitignore).

APP_NAME=pointse
DEBUG=true

# MySQL (port tidak dibuka ke internet)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pointse

# Domain frontend yang diizinkan memanggil API (format JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Folder penyimpanan berkas unggahan (GPKG/GeoJSON), di disk server bukan di DB
DIR_UNGGAHAN=data/unggahan

# Worker pemroses job Proses A/B
# WORKER_ENABLED=false kalau worker dijalankan sebagai proses terpisah
WORKER_ENABLED=true
MAX_WORKERS=1
INTERVAL_POLLING=1.0
